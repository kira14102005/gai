#!/usr/bin/env bash
set -euo pipefail

# 1. Capture the directory where the user typed 'gai' FIRST (before any cd)
export GAI_INVOCATION_CWD="$PWD"

GAI_PROJECT_DIR="/d/hr/gai"
GAI_PYTHON="$GAI_PROJECT_DIR/.venv/Scripts/python.exe"

if [[ ! -f "$GAI_PYTHON" ]]; then
    echo "Error: GAI virtual environment not found: $GAI_PYTHON" >&2
    exit 1
fi

# 2. Now change to the project directory so Python can find the module
cd "$GAI_PROJECT_DIR" || { echo "Error: Failed to change directory to $GAI_PROJECT_DIR" >&2; exit 1; }

export PYTHONPATH="$GAI_PROJECT_DIR"

exec "$GAI_PYTHON" -m src.cli "$@"